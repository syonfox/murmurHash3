{
  "name": "endpoint-murmurhash3",
  "version": "0.2.0",
  "description": "Opinionated pure js MurmurHash3 in TypeScript With a NiceHash in js.",
  "keywords": [
    "128bit",
    "64bit",
    "anti-collision",
    "hash",
    "hashing",
    "incremental",
    "murmmurhash3",
    "murmurhash",
    "progressive",
    "endpoint"
  ],
  "license": "MIT",
  "repository": "github:reemus-dev/murmurhash3-ts",
  "homepage": "",
  "author": {
    "name": "Tarun Ramesh",
    "email": "tarun@reemus.dev"
  },
  "type": "module",
  "main": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "dist/**/*",
    "src/**/*"
  ],
  "exports": {
    "import": "./dist/esm/index.js",
    "require": "./dist/cjs/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run clean && npm run build:esm && npm run build:cjs && cp -R src/niceHash dist/niceHash",
    "build:cjs": "tsc -p tsconfig.cjs.json && echo '{\"type\": \"commonjs\"}' | tee ./dist/cjs/package.json > /dev/null",
    "build:esm": "tsc -p tsconfig.esm.json",
    "clean": "rm -rf ./dist ./coverage",
    "coveralls": "jest --config jestconfig.json --silent --coverage --coverageReporters=text-lcov | coveralls",
    "cs:add": "changeset add",
    "cs:version": "changeset version",
    "lint": "eslint src/**",
    "postinstall": "echo endpoint-murmurhash3",
    "release": "git push"
  },
  "devDependencies": {
    "@tsconfig/recommended": "1.0.2",
    "@types/jest": "29.5.2",
    "@types/node": "20.3.1",
    "@typescript-eslint/eslint-plugin": "5.59.11",
    "@typescript-eslint/parser": "5.59.11",
    "typescript": "5.1.3"
  }
}
